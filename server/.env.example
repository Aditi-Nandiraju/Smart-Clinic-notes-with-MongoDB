# MongoDB connection. Must be a replica set (Atlas clusters always are) so that
# transactions and change streams work. Locally: mongod --replSet rs0
MONGODB_URI=mongodb://127.0.0.1:27017/cnis?replicaSet=rs0

# Optional: a second connection string for a database user that only has the
# "read" role. The assistant runs its generated queries through it.
# READONLY_MONGODB_URI=mongodb+srv://assistant_ro:...@cluster0.xxxx.mongodb.net/cnis

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Change these. Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
FIELD_ENC_KEY=

# Embeddings for semantic search, all local:
#   auto        - use all-MiniLM-L6-v2 (downloaded once into MODEL_CACHE_DIR), else fall back
#   transformer - require the MiniLM model
#   hashing     - clinhash-384 only, no download needed
#   ollama      - OLLAMA_EMBED_MODEL through Ollama (run npm run reindex after switching)
EMBEDDING_MODE=auto
MODEL_CACHE_DIR=./models
# set to false after the first download to guarantee no network access
ALLOW_MODEL_DOWNLOAD=true

# true on MongoDB Atlas after running: npm run indexes
ATLAS_VECTOR_SEARCH=false

# days after the due date before a follow-up counts as missed
FOLLOWUP_GRACE_DAYS=3
# daily overdue check (cron syntax, server time)
OVERDUE_CRON=0 8 * * *

# Local LLM through Ollama (optional; everything works without it).
#   ollama pull qwen2.5:7b        (or llama3.1:8b, mistral:7b ...)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=90000
# auto = use the LLM when Ollama is reachable and the model is pulled; on / off to force
LLM_EXTRACTION=auto
LLM_ASSISTANT=auto

# Retrain the ML tagger after this many new verified notes
NER_RETRAIN_EVERY=50
