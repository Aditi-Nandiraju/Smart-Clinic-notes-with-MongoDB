{
  "name": "cnis-server",
  "version": "1.0.0",
  "description": "Clinical Notes Intelligence System - API with local NLP, ML and an optional Ollama LLM",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node scripts/seed.js",
    "evaluate": "node scripts/evaluate.js",
    "indexes": "node scripts/createIndexes.js",
    "reindex": "node scripts/reindex.js",
    "test": "node --test tests/*.test.js",
    "evaluate:ensemble": "node scripts/evaluateEnsemble.js",
    "agreement": "node scripts/agreement.js",
    "mock-ollama": "node scripts/mockOllama.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "natural": "^8.2.6",
    "node-cron": "^4.6.0",
    "socket.io": "^4.8.4"
  }
}
